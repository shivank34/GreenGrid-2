// GreenGrid Enterprise Energy Management Information System (EMIS)
// Prisma Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  FACILITY_MANAGER
  ENERGY_ANALYST
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FacilityType {
  COMMERCIAL_OFFICE
  MANUFACTURING
  WAREHOUSE_LOGISTICS
  DATA_CENTER
  CAMPUS
  HEALTHCARE
  RETAIL
}

enum MeterType {
  ELECTRICITY_MAIN
  SUBMETER
  SOLAR_PV
  WIND_TURBINE
  BESS
  HVAC
  LIGHTING
}

enum MeterStatus {
  ACTIVE
  OFFLINE
  MAINTENANCE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum OptimizationCategory {
  LOAD_SHIFTING
  PEAK_SHAVING
  EQUIPMENT_EFFICIENCY
  RENEWABLE_DISPATCH
  POWER_FACTOR_CORRECTION
}

enum OptimizationStatus {
  IDENTIFIED
  IN_PROGRESS
  IMPLEMENTED
  DISMISSED
}

enum InvoiceStatus {
  PENDING
  VERIFIED
  DISPUTED
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  QUALIFIED
  CLOSED
}

// -----------------------------------------------------------------------------
// TENANCY & IDENTITY
// -----------------------------------------------------------------------------

model Organization {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  plan        String      @default("ENTERPRISE")
  logoUrl     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  users       User[]
  facilities  Facility[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model User {
  id              String      @id @default(uuid())
  organizationId  String
  email           String      @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole    @default(VIEWER)
  status          UserStatus  @default(ACTIVE)
  isEmailVerified Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  resolvedAlerts  EnergyAlert[]  @relation("AlertResolver")
  auditLogs       AuditLog[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  family      String
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// FACILITY & ASSET AS-BUILT
// -----------------------------------------------------------------------------

model Facility {
  id                    String        @id @default(uuid())
  organizationId        String
  name                  String
  code                  String        @unique
  facilityType          FacilityType  @default(COMMERCIAL_OFFICE)
  address               String
  city                  String
  country               String        @default("USA")
  timezone              String        @default("America/New_York")
  squareMeters          Float
  baselineKwhPerMonth   Float
  targetIntensityKwhM2  Float
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meters                AssetMeter[]
  readings              MeterReading[]
  dailyRollups          DailyEnergyRollup[]
  alerts                EnergyAlert[]
  optimizations         OptimizationRecommendation[]
  invoices              UtilityInvoice[]

  @@index([organizationId])
  @@map("facilities")
}

model AssetMeter {
  id                String        @id @default(uuid())
  facilityId        String
  name              String
  meterNumber       String        @unique
  meterType         MeterType     @default(ELECTRICITY_MAIN)
  status            MeterStatus   @default(ACTIVE)
  apiKeyHash        String?
  installationDate  DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  facility          Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  readings          MeterReading[]
  alerts            EnergyAlert[]

  @@index([facilityId])
  @@index([meterType])
  @@map("asset_meters")
}

// -----------------------------------------------------------------------------
// TIME-SERIES & TELEMETRY
// -----------------------------------------------------------------------------

model MeterReading {
  id              String      @id @default(uuid())
  meterId         String
  facilityId      String
  timestamp       DateTime
  energyKwh       Float
  activePowerKw   Float
  renewableKwh    Float       @default(0)
  gridImportKwh   Float       @default(0)
  gridExportKwh   Float       @default(0)
  voltage         Float       @default(480)
  powerFactor     Float       @default(0.95)
  createdAt       DateTime    @default(now())

  meter           AssetMeter  @relation(fields: [meterId], references: [id], onDelete: Cascade)
  facility        Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([meterId, timestamp(sort: Desc)])
  @@index([facilityId, timestamp(sort: Desc)])
  @@map("meter_readings")
}

model DailyEnergyRollup {
  id                  String    @id @default(uuid())
  facilityId          String
  date                DateTime  @db.Date
  totalKwh            Float
  peakPowerKw         Float
  renewableKwh        Float
  gridImportKwh       Float
  gridExportKwh       Float     @default(0)
  carbonAvoidedKg     Float
  energyCostEstimated Float
  createdAt           DateTime  @default(now())

  facility            Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, date])
  @@index([facilityId, date(sort: Desc)])
  @@map("daily_energy_rollups")
}

// -----------------------------------------------------------------------------
// INTELLIGENCE, ALERTS & OPTIMIZATION
// -----------------------------------------------------------------------------

model EnergyAlert {
  id              String        @id @default(uuid())
  facilityId      String
  meterId         String?
  title           String
  description     String
  severity        AlertSeverity @default(MEDIUM)
  status          AlertStatus   @default(OPEN)
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  facility        Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  meter           AssetMeter?   @relation(fields: [meterId], references: [id], onDelete: SetNull)
  resolver        User?         @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([facilityId, status])
  @@index([severity])
  @@map("energy_alerts")
}

model OptimizationRecommendation {
  id                    String                @id @default(uuid())
  facilityId            String
  title                 String
  description           String
  category              OptimizationCategory  @default(LOAD_SHIFTING)
  potentialSavingsKwh   Float
  potentialSavingsUsd   Float
  carbonReductionTons   Float
  status                OptimizationStatus    @default(IDENTIFIED)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  facility              Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@map("optimization_recommendations")
}

// -----------------------------------------------------------------------------
// UTILITY INVOICING & PROCUREMENT
// -----------------------------------------------------------------------------

model UtilityInvoice {
  id                    String        @id @default(uuid())
  facilityId            String
  invoiceNumber         String
  utilityProvider       String
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  totalKwh              Float
  peakDemandKw          Float
  totalAmount           Float
  currency              String        @default("USD")
  status                InvoiceStatus @default(PENDING)
  documentUrl           String?
  verifiedKwhDifference Float?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  facility              Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, invoiceNumber])
  @@index([facilityId, status])
  @@map("utility_invoices")
}

// -----------------------------------------------------------------------------
// MARKETING, LEADS & AUDIT LOGS
// -----------------------------------------------------------------------------

model LeadInquiry {
  id              String      @id @default(uuid())
  fullName        String
  workEmail       String
  companyName     String
  facilityCount   Int?
  estimatedSpend  String?
  notes           String?
  status          LeadStatus  @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([workEmail])
  @@index([status])
  @@map("lead_inquiries")
}

model AuditLog {
  id              String        @id @default(uuid())
  organizationId  String
  userId          String?
  action          String
  entity          String
  entityId        String
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
