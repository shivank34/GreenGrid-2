# ==============================================================================
# GreenGrid Backend - Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="file:./dev.db"

# Authentication & JWT Secrets
# Generate random 64-char strings for production: `openssl rand -hex 32`
JWT_SECRET=greengrid_development_jwt_secret_key_super_secure_32_bytes_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=greengrid_development_refresh_jwt_secret_key_super_secure_min
JWT_REFRESH_EXPIRES_IN=7d

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=greengrid_demo@ethereal.email
EMAIL_PASSWORD=greengrid_secret_pass
EMAIL_FROM=GreenGrid Platform <noreply@greengrid.example>

# Structured Logging
LOG_LEVEL=debug
